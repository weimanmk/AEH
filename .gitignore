# Local reference checkouts: read-only, never commit
references/

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Test and tooling caches
node_modules/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.tsbuildinfo

# Node / npm local caches (never commit; separate from the runtime harness)
node_modules/
.npm-cache/

# Step 18 isolated dsh runtime state (regenerated by step18/run-e2e.py):
# the isolated $DSH_HOME, its profile, the local npm install, and scratch cwd.
# The committed evidence lives in step18/evidence/.
step18/home/
step18/work/
step18/runtime/
step18/dump-config.txt
step18/dump-config.err

# Virtual environments
.venv/
venv/
env/
ENV/

# Build artifacts
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# Local logs and temporary files
*.log
*.tmp
*.swp
*~

# OS / editor metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sublime-workspace

# Secrets and local configuration (never commit)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
credentials.json

# Local databases / dumps
*.sqlite
*.sqlite3
*.db
