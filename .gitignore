# Local reference checkouts: read-only, never commit
references/

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Test and tooling caches
node_modules/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.tsbuildinfo

# Node / npm local caches (never commit; separate from the runtime harness)
node_modules/
.npm-cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Build artifacts
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# Local logs and temporary files
*.log
*.tmp
*.swp
*~

# OS / editor metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sublime-workspace

# Secrets and local configuration (never commit)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
credentials.json

# Local databases / dumps
*.sqlite
*.sqlite3
*.db
