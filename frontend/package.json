{
  "name": "aeh-frontend-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AEH 本地教师工作台：直接运行 dsh-plugin 的真实 TypeScript 核心，数据只存浏览器 localStorage。",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "check": "node scripts/check-core-behaviors.mjs",
    "smoke:ssr": "node scripts/ssr-smoke.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  }
}
